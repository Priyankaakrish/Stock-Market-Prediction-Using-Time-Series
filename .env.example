# Copy to .env and fill in. Never commit the real file.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://nvda-mlflow:5002
MLFLOW_EXPERIMENT=nvda-price-forecasting
MLFLOW_ARTIFACT_ROOT=s3://your-bucket/mlflow-artifacts

# --- Serving ---
# Unset -> serve the pickle baked into the image.
# Set   -> pull a staged version from the registry.
MODEL_URI=
CORS_ORIGINS=*

# --- AWS ---
AWS_REGION=ap-south-1
S3_BUCKET=your-nvda-bucket
IMAGE_TAG=latest

# Credentials come from the EC2 instance profile or AWS Secrets Manager.
# Do not put AWS_SECRET_ACCESS_KEY in this file.
